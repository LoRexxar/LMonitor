+// 分别分析 DBC 条件分支，不能把互斥分支拼成一句，也不能丢失分支里的数值引用。
+std::vector<std::string> skill_damage_scope_text_variants( const std::string& text )
+{
+  std::vector<std::string> pending{ text }, result;
+  while ( !pending.empty() )
+  {
+    std::string current = pending.back(); pending.pop_back();
+    size_t start = current.find("$?");
+    if ( start == std::string::npos ) { result.push_back(current); continue; }
+    size_t cursor = start + 1;
+    std::vector<std::string> branches;
+    bool valid = true;
+    const auto bracket = [&]( size_t& pos, std::string& branch ) {
+      if ( pos >= current.size() || current[pos] != '[' ) return false;
+      const size_t begin = ++pos;
+      unsigned depth = 1;
+      while ( pos < current.size() && depth )
+      {
+        if ( current[pos] == '[' ) ++depth;
+        else if ( current[pos] == ']' ) --depth;
+        ++pos;
+      }
+      if ( depth ) return false;
+      branch = current.substr(begin, pos - begin - 1); return true;
+    };
+    while ( cursor < current.size() && current[cursor] == '?' )
+    {
+      cursor = current.find('[', cursor);
+      std::string branch;
+      if ( cursor == std::string::npos || !bracket(cursor, branch) ) { valid = false; break; }
+      branches.push_back(branch);
+    }
+    std::string fallback;
+    if ( !valid || !bracket(cursor, fallback) ) { result.push_back(current); continue; }
+    branches.push_back(fallback);
+    // 复杂表达式不做不完整展开；原文仍可进入待核对清单。
+    if ( pending.size() + result.size() + branches.size() > 128 ) { result.push_back(current); continue; }
+    for ( const auto& branch : branches )
+      pending.push_back(current.substr(0,start) + branch + current.substr(cursor));
+  }
+  return result;
+}
