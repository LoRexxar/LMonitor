+// 所有消费者共享同一份分量闭包；结果不依赖当前动作数量、数值比例或本地化名称。
+#pragma once
+#include "skill_damage_semantic_rules.inc"
+#include <map>
+#include <set>
+#include <vector>
+
+inline bool skill_damage_unrestricted_result(const spelleffect_data_t& e)
+{
+  if (e.type() != E_APPLY_AURA && e.type() != E_APPLY_AREA_AURA_PARTY &&
+      e.type() != E_APPLY_AURA_PLAYER_AND_PET) return false;
+  for (unsigned i=0; i<NUM_CLASS_FAMILY_FLAGS; ++i) if (e.class_flags(i)) return false;
+  switch (e.subtype())
+  {
+    case A_MOD_DAMAGE_PERCENT_DONE: case A_MOD_ALL_CRIT_CHANCE:
+    case A_HASTE_ALL: case A_MOD_CRIT_DAMAGE_MULTIPLIER:
+    case A_MOD_CRIT_PERCENT: case A_MOD_SPELL_CRIT_CHANCE: case A_MOD_SPELL_CRIT_CHANCE_SCHOOL:
+      return true;
+    default: return false;
+  }
+}
+
+inline bool skill_damage_public_selector(const spelleffect_data_t& e)
+{
+  if (e.type() != E_APPLY_AURA) return false;
+  if (e.subtype() != A_ADD_PCT_MODIFIER && e.subtype() != A_ADD_FLAT_MODIFIER &&
+      e.subtype() != A_MOD_DAMAGE_FROM_CASTER_SPELLS) return false;
+  if (e.misc_value1()!=P_GENERIC && e.misc_value1()!=P_TICK_DAMAGE &&
+      e.misc_value1()!=P_CRIT && e.misc_value1()!=P_CRIT_BONUS) return false;
+  for (const auto& selector: skill_damage_semantic_selectors)
+    if (e.spell()->class_family()==selector.family && (e.class_flags(selector.word)&selector.mask)) return true;
+  // 同版复核的组合选择器，缺少任一位都不能扩大为公共作用域。
+  return e.spell()->class_family()==10 && (e.class_flags(1)&16384) && (e.class_flags(2)&2);
+}
+
+inline const std::vector<skill_damage_scope_effect_t>& skill_damage_effect_scope(const dbc_t& dbc)
+{
+  static std::map<bool,std::vector<skill_damage_scope_effect_t>> cache;
+  auto found=cache.find(dbc.ptr);
+  if (found!=cache.end()) return found->second;
+  std::map<std::pair<unsigned,unsigned>,skill_damage_scope_effect_t> facts;
+  for (const auto& fact: skill_damage_scope_effects) facts[{fact.spell,fact.index}]=fact;
+  for (const auto& spell: spell_data_t::data(dbc.ptr))
+    if (spell.class_family())
+    for (const auto& e: spell.effects())
+    {
+      const bool unrestricted=skill_damage_unrestricted_result(e);
+      const auto key=std::make_pair(spell.id(),e.index()+1);
+      if (!unrestricted && (!skill_damage_public_selector(e) || facts.count(key))) continue;
+      facts[key]={spell.id(), e.index()+1, e.id(), spell.class_family(), true, false};
+    }
+  auto& result=cache[dbc.ptr];
+  for (const auto& [key,fact]:facts) result.push_back(fact);
+  return result;
+}
+
+// 沿结构化触发关系追溯来源，不根据名称或同职业关系授予专精归属。
+inline std::set<unsigned> skill_damage_trigger_closure(const dbc_t& dbc, unsigned root)
+{
+  std::set<unsigned> seen;
+  std::vector<unsigned> pending{root};
+  while (!pending.empty())
+  {
+    unsigned id=pending.back(); pending.pop_back();
+    if (!id || !seen.insert(id).second) continue;
+    for (const auto& e:spell_data_t::find(id,dbc.ptr)->effects())
+      if (e.trigger_spell_id()) pending.push_back(e.trigger_spell_id());
+  }
+  return seen;
+}
+
+inline const std::map<unsigned,std::set<unsigned>>& skill_damage_global_components(const dbc_t& dbc)
+{
+  static std::map<bool,std::map<unsigned,std::set<unsigned>>> cache;
+  auto found=cache.find(dbc.ptr);
+  if (found!=cache.end()) return found->second;
+  auto& result=cache[dbc.ptr];
+  for (const auto& fact:skill_damage_effect_scope(dbc)) if (fact.global) result[fact.spell].insert(fact.index);
+  return result;
+}
+
+inline bool skill_damage_semantic_global_spell(const dbc_t& dbc,unsigned spell)
+{ return skill_damage_global_components(dbc).count(spell)!=0; }
+
+inline bool skill_damage_semantic_mixed_spell(const dbc_t& dbc,unsigned spell)
+{
+  for (const auto& fact:skill_damage_scope_buffs) if (fact.spell==spell && fact.local) return true;
+  const auto found=skill_damage_global_components(dbc).find(spell);
+  if (found==skill_damage_global_components(dbc).end()) return false;
+  // 保留状态开关；未归一化的分量可能是资源、治疗或局部触发条件，不能删掉整个Buff。
+  for (const auto& e:spell_data_t::find(spell,dbc.ptr)->effects())
+    if (e.type()!=E_NONE && !found->second.count(e.index()+1)) return true;
+  return false;
+}
