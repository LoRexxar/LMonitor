+// 新效果自动进入同一份展示目录。只补结构化规则新增的物理分量，不复制复核目录。
+void write_skill_damage_semantic_scope(std::ostream& out,player_t& player,bool& first)
+{
+  std::set<std::pair<unsigned,unsigned>> reviewed;
+  for(const auto& fact:skill_damage_scope_effects) if(fact.global) reviewed.emplace(fact.spell,fact.index);
+  std::map<unsigned,unsigned> sources;
+  const auto spec=static_cast<unsigned>(player.specialization());
+  for(const auto& trait:trait_data_t::data(player.is_ptr()))
+  {
+    if(trait.id_class!=static_cast<unsigned>(util::class_id(player.type))) continue;
+    bool restricted=false, matches=false;
+    for(auto id:trait.id_spec) { restricted|=id!=0; matches|=id==spec; }
+    if(restricted && !matches) continue;
+    for(auto id:skill_damage_trigger_closure(*player.dbc,trait.id_spell)) sources.emplace(id,trait.id_trait_node_entry);
+  }
+  for(auto id:skill_damage_catalog(player).spells) sources.emplace(id,0);
+  for(auto* buff:player.buff_list)
+    if(buff->source==&player && buff->player==&player && skill_damage_available_buff(player,*buff)) sources[buff->data().id()]=0;
+  if(player.target) for(auto* buff:player.target->buff_list)
+    if(buff->source==&player && skill_damage_available_buff(player,*buff)) sources[buff->data().id()]=0;
+  for(const auto& [id,trait]:sources)
+  {
+    const auto* spell=spell_data_t::find(id,player.is_ptr());
+    if(spell->class_family()!=static_cast<unsigned>(dbc::get_class_spell_family(player.type))) continue;
+    std::vector<const spelleffect_data_t*> effects;
+    for(const auto& e:spell->effects())
+      if(e.id() && skill_damage_global_components(*player.dbc).count(id) &&
+         skill_damage_global_components(*player.dbc).at(id).count(e.index()+1) &&
+         !reviewed.count({id,e.index()+1})) effects.push_back(&e);
+    if(effects.empty()) continue;
+    if(!first) out<<','; first=false;
+    out<<"{\"effect_id\":\"semantic_scope:"<<id<<"\",\"source_type\":\"reviewed_scope\",\"source_kind\":\""<<(trait?"talent":"buff")<<"\",\"source_name\":";
+    apl_metadata_json_string(out,spell->name_cstr());
+    if(trait) out<<",\"trait_entry_id\":"<<trait;
+    out<<",\"source_spell_ids\":["<<id<<"],\"source_class\":";
+    apl_metadata_json_string(out,util::player_type_string(player.type));
+    out<<",\"specializations\":[";
+    apl_metadata_json_string(out,util::tokenize_fn(dbc::specialization_string(player.specialization())));
+    out<<"],\"scope_evidence\":\"dbc_semantic_effect_scope\",\"excluded_before_probe\":true,\"partial_state\":"
+       <<(skill_damage_semantic_mixed_spell(*player.dbc,id)?"true":"false")
+       <<",\"lower_skill_policy\":\"exclude_global_keep_explicit_local\",\"projections\":[],\"global_components\":[";
+    bool component_first=true;
+    for(const auto* e:effects)
+    { if(!component_first) out<<','; component_first=false;
+      out<<"{\"spell_id\":"<<id<<",\"effect_index\":"<<e->index()+1<<",\"effect_id\":"<<e->id()<<'}'; }
+    out<<"],\"effect_details\":["; component_first=true;
+    for(const auto* e:effects)
+    { if(!component_first) out<<','; component_first=false;
+      out<<"{\"source_spell_id\":"<<id<<",\"effect_index\":"<<e->index()+1<<",\"base_value\":"<<e->base_value()
+         <<",\"value_kind\":\"percent\",\"evidence\":\"dbc_native\",\"conditional\":false,\"label\":";
+      apl_metadata_json_string(out,e->subtype()==A_MOD_ALL_CRIT_CHANCE?"公共暴击率":e->subtype()==A_HASTE_ALL?"公共急速":"公共效果分量"); out<<'}'; }
+    out<<"]}";
+  }
+}
