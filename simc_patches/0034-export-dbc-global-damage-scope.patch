+// 根据 DBC aura 的作用域声明全技能增伤，不使用抽样技能数或本地化描述。
+void write_skill_damage_global_states( std::ostream& out, player_t& player )
+{
+  bool first = true;
+  const auto write_buff = [&]( buff_t* buff, bool target ) {
+    if ( !buff || !buff->data().ok() || buff->source != &player ) return;
+    for ( const auto& effect : buff->data().effects() )
+    {
+      if ( effect.type() != E_APPLY_AURA || effect.percent() <= 0.0 ) continue;
+      bool scoped = false;
+      for ( unsigned i = 0; i < NUM_CLASS_FAMILY_FLAGS; ++i )
+        scoped = scoped || effect.class_flags( i ) != 0;
+      if ( scoped ) continue;
+      const bool all_schools = effect.misc_value1() == 127;
+      const bool global = target
+        ? ( effect.subtype() == A_MOD_DAMAGE_FROM_CASTER ||
+            ( effect.subtype() == A_MOD_DAMAGE_PERCENT_TAKEN && all_schools ) )
+        : effect.subtype() == A_MOD_DAMAGE_PERCENT_DONE && all_schools;
+      if ( !global ) continue;
+      if ( !first ) out << ',';
+      first = false;
+      out << "{\"token\":";
+      apl_metadata_json_string( out, ( target ? "debuff." : "buff." ) + buff->name_str );
+      out << ",\"scope\":"; apl_metadata_json_string( out, target ? "target" : "self" );
+      out << ",\"spell_id\":" << buff->data().id() << ",\"name\":";
+      apl_metadata_json_string( out, buff->data().name_cstr() );
+      out << ",\"evidence\":\"dbc_all_school_damage_aura\"}";
+      break;
+    }
+  };
+  out << '[';
+  for ( buff_t* buff : player.buff_list )
+    if ( buff && buff->player == &player ) write_buff( buff, false );
+  if ( player.target )
+    for ( buff_t* buff : player.target->buff_list )
+      if ( buff && buff->player == player.target ) write_buff( buff, true );
+  out << ']';
+}
