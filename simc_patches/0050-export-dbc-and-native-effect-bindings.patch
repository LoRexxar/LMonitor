+// 直接使用 SimC 的 DBC 索引，不通过描述推断作用技能。
+void skill_damage_write_dbc_relation( std::ostream& out, const dbc_t& dbc, const spelleffect_data_t& e )
+{
+  std::vector<const spell_data_t*> affected;
+  const char* method = "no_static_spell_selector";
+  if ( e.subtype() == 107 || e.subtype() == 108 || e.subtype() == 220 || e.subtype() == 416 || e.subtype() == 417 )
+  {
+    affected = dbc.effect_affects_spells(e.spell()->class_family(), &e);
+    method = "dbc.effect_affects_spells";
+  }
+  else if ( e.subtype() == 218 || e.subtype() == 219 || e.subtype() == 320 )
+  {
+    auto matches = dbc.spells_by_label(e.misc_value2());
+    affected.assign(matches.begin(), matches.end()); method = "dbc.spells_by_label";
+  }
+  else if ( e.subtype() == 271 || e.subtype() == 537 )
+  {
+    for ( const auto& candidate : spell_data_t::data(dbc.ptr) )
+      if ( candidate.affected_by_all(e) ) affected.push_back(&candidate);
+    method = "spell_data_t.affected_by_all";
+  }
+  out << "{\"effect_id\":" << e.id() << ",\"source_spell_id\":" << e.spell()->id()
+      << ",\"effect_index\":" << e.index()+1 << ",\"class_family\":" << e.spell()->class_family()
+      << ",\"type\":" << e.type() << ",\"subtype\":" << e.subtype()
+      << ",\"misc1\":" << e.misc_value1() << ",\"misc2\":" << e.misc_value2()
+      << ",\"base_value\":" << e.base_value() << ",\"method\":";
+  apl_metadata_json_string(out,method);
+  out << ",\"flags\":[";
+  for(unsigned i=0;i<NUM_CLASS_FAMILY_FLAGS;++i){if(i)out<<',';out<<e.class_flags(i);}
+  out << "],\"affected_spells\":[";
+  bool first = true;
+  for ( const auto* s : affected )
+  {
+    if ( !first ) out << ','; first = false;
+    out << "{\"spell_id\":" << s->id() << ",\"name\":";
+    apl_metadata_json_string(out,s->name_cstr());
+    out << ",\"school\":" << s->school_mask() << ",\"class_family\":" << s->class_family()
+        << ",\"dbc_direct_damage\":" << (range::any_of(s->effects(), [](const spelleffect_data_t& e) { return e.type() == E_SCHOOL_DAMAGE || e.type() == E_HEALTH_LEECH || e.type() == E_NORMALIZED_WEAPON_DMG || e.type() == E_WEAPON_DAMAGE || e.type() == E_WEAPON_PERCENT_DAMAGE; })?"true":"false")
+        << ",\"dbc_periodic_damage\":" << (range::any_of(s->effects(), [](const spelleffect_data_t& e) { return e.type() == E_APPLY_AURA && (e.subtype() == A_PERIODIC_DAMAGE || e.subtype() == A_PERIODIC_LEECH || e.subtype() == A_PERIODIC_DAMAGE_PERCENT); })?"true":"false") << '}';
+  }
+  out << "]}";
+}
