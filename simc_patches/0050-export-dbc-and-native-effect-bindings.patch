+// 独立原生审计：正常初始化后读取实际注册关系，不清零全局分量、不调用文本分类器。
+void export_skill_damage_native_evidence( sim_t& sim )
+{
+  std::ofstream out(sim.skill_damage_evidence_export_file, std::ios::binary | std::ios::trunc);
+  out << "{\"evidence_schema\":1,\"normalized\":false,\"actors\":[";
+  bool fa = true;
+  for ( player_t* owner : sim.player_list )
+  {
+    if ( !owner->is_player() ) continue;
+    if ( !fa ) out << ','; fa = false;
+    out << "{\"class\":"; apl_metadata_json_string(out,util::player_type_string(owner->type));
+    out << ",\"spec\":"; apl_metadata_json_string(out,util::specialization_string(owner->specialization()));
+    out << ",\"selected_trait_ids\":[";
+    bool fs = true;
+    for ( const auto& t : owner->player_traits ) { if (!fs) out << ','; fs=false; out << std::get<1>(t); }
+    out << "],\"bindings\":[";
+    bool fb = true;
+    std::set<unsigned> source_effects;
+    std::vector<player_t*> entities{owner};
+    for ( auto* pet : owner->pet_list ) entities.push_back(pet);
+    for ( const auto* entity : entities )
+    {
+      const auto emit = [&](const spelleffect_data_t* e, unsigned target, const std::string& field,
+                            const char* layer, buff_t* buff, unsigned flags, bool conditional) {
+        if (!e || !e->id()) return;
+        if (!fb) out << ','; fb=false;
+        source_effects.insert(e->id());
+        out << "{\"source_spell_id\":" << e->spell()->id() << ",\"effect_id\":" << e->id()
+            << ",\"effect_index\":" << e->index()+1 << ",\"target_spell_id\":" << target
+            << ",\"base_value\":" << e->base_value() << ",\"layer\":";
+        apl_metadata_json_string(out,layer); out << ",\"field\":"; apl_metadata_json_string(out,field);
+        out << ",\"entity\":"; apl_metadata_json_string(out,entity->name_str);
+        out << ",\"pet\":" << (entity!=owner?"true":"false") << ",\"parse_flags\":" << flags
+            << ",\"conditional\":" << (conditional?"true":"false") << ",\"buff_spell_id\":" << (buff?buff->data().id():0)
+            << ",\"buff_class_family\":" << (buff?buff->data().class_family():0)
+            << ",\"owner_class_family\":" << dbc::get_class_spell_family(owner->type);
+        out << ",\"buff_token\":"; apl_metadata_json_string(out,buff?buff->name_str:"");
+        out << ",\"buff_default_chance\":" << (buff?buff->default_chance:0)
+            << ",\"buff_max_stack\":" << (buff?buff->max_stack():0)
+            << ",\"self_owned\":" << (!buff || (buff->source==entity && buff->player==entity)?"true":"false") << '}';
+      };
+      for ( const auto& [field,groups] : entity->reporting_parse_player )
+        for ( const auto& [misc,effects] : groups )
+          for ( const auto* e : effects ) emit(e,0,field,"passive_player",nullptr,0,false);
+      for ( const auto& [target,fields] : entity->reporting_parse_action )
+        for ( const auto& [field,effects] : fields )
+          for ( const auto* e : effects ) emit(e,target,field,"passive_action",nullptr,0,false);
+      for ( const auto& [target,indices] : entity->reporting_parse_effect )
+        for ( const auto& [index,effects] : indices )
+          for ( const auto* e : effects ) emit(e,target,"effect_"+std::to_string(index),"passive_effect",nullptr,0,false);
+      const auto player_bank = [&](const auto& entries,const char* field,unsigned target,const char* layer) {
+        for ( const auto& e : entries ) emit(e.eff,target,field,layer,e.buff,e.type,bool(e.func)||bool(e.value_func));
+      };
+      if ( const auto* parsed=dynamic_cast<const parse_player_effects_t*>(entity) )
+      {
+        player_bank(parsed->player_multiplier_effects,"player_multiplier",0,"player_registry");
+        player_bank(parsed->pet_multiplier_effects,"pet_multiplier",0,"player_registry");
+        player_bank(parsed->crit_bonus_effects,"crit_bonus",0,"player_registry");
+        player_bank(parsed->crit_chance_effects,"crit_chance",0,"player_registry");
+        player_bank(parsed->auto_attack_speed_effects,"auto_attack_speed",0,"player_registry");
+      }
+      for ( const auto* action : entity->action_list )
+      {
+        if (!action || !action->harmful || action->type==ACTION_HEAL || action->type==ACTION_ABSORB) continue;
+        const auto* parsed=dynamic_cast<const parse_action_base_t*>(action);
+        if (!parsed) continue;
+        const auto target=apl_metadata_action_spell_id(*action);
+        player_bank(parsed->da_multiplier_effects,"direct_damage",target,"action_registry");
+        player_bank(parsed->ta_multiplier_effects,"periodic_damage",target,"action_registry");
+        player_bank(parsed->crit_bonus_effects,"crit_bonus",target,"action_registry");
+        player_bank(parsed->crit_chance_effects,"crit_chance",target,"action_registry");
+        player_bank(parsed->dot_duration_effects,"duration",target,"action_registry");
+        player_bank(parsed->tick_time_effects,"tick_time",target,"action_registry");
+        for (const auto& e:parsed->target_multiplier_effects)
+          emit(e.eff,target,"target_multiplier","target_registry",nullptr,e.type,bool(e.func));
+      }
+    }
+    out << "],\"source_effects\":[";
+    bool fe=true;
+    for (const auto& e:spelleffect_data_t::data(sim.dbc->ptr)) if(source_effects.count(e.id()))
+    { if(!fe) out << ','; fe=false; skill_damage_write_dbc_relation(out,*sim.dbc,e); }
+    out << "],\"damage_actions\":[";
+    bool fd=true;
+    for(const auto* entity:entities) for(const auto* a:entity->action_list)
+    {
+      if(!a || !a->harmful || a->type==ACTION_HEAL || a->type==ACTION_ABSORB ||
+         (!a->does_direct_damage() && !a->does_periodic_damage()) || a->external_recipient_action()) continue;
+      if(!fd) out << ','; fd=false;
+      out << "{\"spell_id\":" << apl_metadata_action_spell_id(*a) << ",\"token\":";
+      apl_metadata_json_string(out,a->name_str); out << ",\"periodic\":" << (a->does_periodic_damage()?"true":"false")
+          << ",\"pet\":" << (entity!=owner?"true":"false") << '}';
+    }
+    out << "]}";
+  }
+  out << "]}\n";
+  if(!out) throw std::runtime_error("Unable to write native scope evidence");
+}
