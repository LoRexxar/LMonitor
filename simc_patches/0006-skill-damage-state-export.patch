@@ -93,6 +93,10 @@ struct sim_t : private sc_thread_t
   std::string apl_metadata_export_file;
   std::string apl_metadata_revision;
   std::string apl_metadata_game_build;
+  // Runtime skill damage probe mode. Actors initialize, but no simulation executes.
