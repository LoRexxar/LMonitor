+    double hit = 0.0, crit = 0.0, crit_multiplier = 1.0, crit_chance = 0.0, expected = 0.0;
     bool present = false;
   } direct_amount, tick_amount;
   bool direct = false, periodic = false;
   std::string unresolved_reason;
 };
 
+struct skill_damage_dbc_scaling_t
+{
+  struct component_t
+  {
+    double attack_power_coefficient = 0.0;
+    double spell_power_coefficient = 0.0;
+    std::vector<unsigned> effect_indexes;
+
+    bool present() const { return !effect_indexes.empty(); }
+    double normalized_base() const
+    { return 100.0 * ( attack_power_coefficient + spell_power_coefficient ); }
+  } direct, tick;
+};
+
+skill_damage_dbc_scaling_t skill_damage_dbc_scaling( const action_t& action )
+{
+  skill_damage_dbc_scaling_t scaling;
+  for ( const auto& effect : action.data().effects() )
+  {
+    skill_damage_dbc_scaling_t::component_t* component = nullptr;
+    if ( effect.type() == E_SCHOOL_DAMAGE )
+      component = &scaling.direct;
+    else if ( effect.type() == E_APPLY_AURA && effect.subtype() == A_PERIODIC_DAMAGE )
+      component = &scaling.tick;
+    if ( !component ) continue;
+    component->attack_power_coefficient += effect.ap_coeff();
+    component->spell_power_coefficient += effect.sp_coeff();
+    component->effect_indexes.push_back( effect.index() );
+  }
+  return scaling;
+}
+
+void write_skill_damage_dbc_component( std::ostream& out,
+                                       const skill_damage_dbc_scaling_t::component_t& component )
+{
+  if ( !component.present() ) { out << "null"; return; }
+  out << "{\"attack_power_coefficient\":" << component.attack_power_coefficient;
+  out << ",\"spell_power_coefficient\":" << component.spell_power_coefficient;
+  out << ",\"normalized_base\":" << component.normalized_base();
+  out << ",\"effect_indexes\":[";
+  for ( size_t i = 0; i < component.effect_indexes.size(); ++i )
+  {
+    if ( i ) out << ',';
+    out << component.effect_indexes[ i ];
+  }
+  out << "]}";
+}
