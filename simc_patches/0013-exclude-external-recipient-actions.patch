+bool skill_damage_external_recipient_action( const action_t& action )
+{
+  // The Evoker module creates these actions on every player whenever any Evoker
+  // is present. Their source Evoker is assigned only when an external-support
+  // callback fires, so they are recipient-side team effects rather than the
+  // actor's own skills or selected-talent damage.
+  static const std::set<std::string_view> external_recipient_actions = {
+    "infernos_blessing",
+    "blistering_scales_damage",
+    "fate_mirror_damage",
+    "fate_mirror_heal",
+    "breath_of_eons_damage",
+    "bombardments",
+  };
+  return external_recipient_actions.find( action.name_str ) != external_recipient_actions.end();
+}
