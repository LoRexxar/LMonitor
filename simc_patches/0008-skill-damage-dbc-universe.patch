+struct skill_damage_dbc_candidate_t
+{
+  unsigned spell_id = 0;
+  std::string source;
+  std::string name;
+  std::vector<action_t*> actions;
+  std::string unresolved_reason;
+};
+
+std::unordered_map<const player_t*, std::vector<skill_damage_dbc_candidate_t>> skill_damage_dbc_candidates;
+
+void prepare_skill_damage_dbc_actions( player_t* player )
+{
+  if ( !player->is_player() )
+    return;
+
+  const auto class_id = static_cast<unsigned>( util::class_id( player->type ) );
+  const auto spec_id = static_cast<unsigned>( player->specialization() );
+  std::map<unsigned, skill_damage_dbc_candidate_t> candidates;
+  auto add_candidate = [ &candidates ]( unsigned spell_id, std::string_view source, std::string_view name ) {
+    if ( !spell_id )
+      return;
+    auto [ it, inserted ] = candidates.try_emplace(
+        spell_id,
+        skill_damage_dbc_candidate_t{
+          spell_id, std::string( source ), std::string( name ), {}, std::string()
+        } );
+    if ( !inserted && it->second.source.find( source ) == std::string::npos )
+      it->second.source += "+" + std::string( source );
+  };
+
+  for ( const auto& entry : active_class_spell_t::data( player->is_ptr() ) )
+    if ( entry.class_id == class_id && ( entry.spec_id == 0 || entry.spec_id == spec_id ) )
+      add_candidate( entry.spell_id, "active_class_spell", entry.name );
+
+  for ( const auto& entry : specialization_spell_entry_t::data( player->is_ptr() ) )
+    if ( entry.class_id == class_id && entry.specialization_id == spec_id )
+      add_candidate( entry.spell_id, "specialization_spell", entry.name );
+
+  for ( const auto& player_trait : player->player_traits )
+  {
+    const auto trait_entry_id = std::get<1>( player_trait );
+    const auto rank = std::get<2>( player_trait );
+    if ( !rank )
+      continue;
+    const auto* trait = trait_data_t::find( trait_entry_id, player->is_ptr() );
+    if ( trait && trait->id_spell )
+      add_candidate( trait->id_spell, "selected_player_trait", trait->name );
+  }
+
+  auto& stored = skill_damage_dbc_candidates[ player ];
+  stored.reserve( candidates.size() );
+  for ( auto& [ spell_id, candidate ] : candidates )
+  {
+    const auto action_names = player->action_names_from_spell_id( spell_id );
+    if ( action_names.empty() )
+    {
+      candidate.unresolved_reason = "dbc_spell_has_no_action_mapping";
+      stored.push_back( std::move( candidate ) );
+      continue;
+    }
+
+    bool creation_failed = false;
+    bool ignored_non_damage_utility = false;
+    bool has_non_ignored_mapping = false;
+    for ( const auto& action_name : action_names )
+    {
+      if ( action_name == "dismiss_pet" )
+      {
+        ignored_non_damage_utility = true;
+        continue;
+      }
+      has_non_ignored_mapping = true;
+      try
+      {
+        action_t* action = player->find_action( action_name );
+        if ( !action )
+          action = player->create_action( action_name, "" );
+        if ( action && std::find( candidate.actions.begin(), candidate.actions.end(), action ) == candidate.actions.end() )
+          candidate.actions.push_back( action );
+      }
+      catch ( const std::exception& )
+      {
+        creation_failed = true;
+      }
+    }
+    if ( candidate.actions.empty() && ignored_non_damage_utility && !has_non_ignored_mapping && !creation_failed )
+      continue;
+    if ( candidate.actions.empty() )
+      candidate.unresolved_reason = creation_failed
+        ? "dbc_action_creation_failed"
+        : "dbc_action_not_implemented";
+    stored.push_back( std::move( candidate ) );
+  }
+}
