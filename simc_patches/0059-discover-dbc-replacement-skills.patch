+// 替换技能的解锁状态是施法前提，独立于增伤条件的差分裁剪。
+std::map<const action_t*, std::vector<skill_damage_condition_t>> skill_damage_activation_conditions;
+
+bool skill_damage_replacement_ready( action_t& action, const std::set<unsigned>& drivers,
+                                     std::vector<skill_damage_condition_t>& required )
+{
+  auto& player = *action.player;
+  const auto probe = [&]( buff_t* buff ) {
+    player.reset();
+    for ( int index = RESOURCE_HEALTH + 1; index < RESOURCE_MAX; ++index )
+    {
+      const auto resource = static_cast<resource_e>( index );
+      player.resources.current[resource] = player.resources.max[resource];
+    }
+    if ( buff ) { buff->current_stack=1; buff->current_value=buff->default_value; buff->invalidate_cache(); }
+    const bool ready = action.ready();
+    if ( buff ) { buff->current_stack=0; buff->current_value=0; buff->invalidate_cache(); }
+    return ready;
+  };
+  if ( probe( nullptr ) ) return true;
+  for ( auto* buff : player.buff_list )
+    if ( buff->source == &player && buff->player == &player && drivers.count( buff->data().id() ) && probe( buff ) )
+    {
+      required.push_back( { skill_damage_condition_scope_e::SELF, buff, "buff."+buff->name_str, 1 } );
+      return true;
+    }
+  return false;
+}
