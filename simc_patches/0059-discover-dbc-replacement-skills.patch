diff --git a/engine/player/skill_damage_catalog.hpp b/engine/player/skill_damage_catalog.hpp
new file mode 100644
--- /dev/null
+++ b/engine/player/skill_damage_catalog.hpp
@@ -0,0 +1,63 @@
+#pragma once
+
+#include "dbc/class_spells.hpp"
+#include "dbc/specialization_spell.hpp"
+#include "dbc/trait_data.hpp"
+#include <map>
+#include <set>
+#include <vector>
+
+// 目录和导出审计共用同一份 DBC 闭包，避免只创建动作却漏报其来源。
+struct skill_damage_catalog_t
+{
+  std::set<unsigned> spells;
+  std::map<unsigned, std::set<unsigned>> replacement_drivers;
+};
+
+inline skill_damage_catalog_t skill_damage_catalog( const player_t& player )
+{
+  skill_damage_catalog_t result;
+  const auto class_id = static_cast<unsigned>( util::class_id( player.type ) );
+  const auto spec_id = static_cast<unsigned>( player.specialization() );
+  for ( const auto& entry : active_class_spell_t::data( player.is_ptr() ) )
+    if ( entry.class_id == class_id && ( entry.spec_id == 0 || entry.spec_id == spec_id ) )
+      result.spells.insert( entry.spell_id );
+  for ( const auto& entry : specialization_spell_entry_t::data( player.is_ptr() ) )
+    if ( entry.class_id == class_id && entry.specialization_id == spec_id )
+      result.spells.insert( entry.spell_id );
+  for ( const auto& selected : player.player_traits )
+    if ( std::get<2>( selected ) > 0 )
+      if ( const auto* trait = trait_data_t::find( std::get<1>( selected ), player.is_ptr() ) )
+        if ( trait->id_spell ) result.spells.insert( trait->id_spell );
+
+  const auto original = result.spells;
+  std::vector<unsigned> pending( original.begin(), original.end() );
+  // 单项天赋探针未必显式选择触发技能，但职业原生 Buff 已持有替换规则。
+  // 这里只寻找替换边；是否真正解锁仍由对应动作的 ready 判断。
+  for ( const auto* buff : player.buff_list )
+    if ( buff->source == &player && buff->player == &player && buff->data().ok() &&
+         buff->data().class_family() == dbc::get_class_spell_family( player.type ) )
+      pending.push_back( buff->data().id() );
+  std::set<unsigned> visited;
+  while ( !pending.empty() )
+  {
+    const auto id = pending.back(); pending.pop_back();
+    const auto* spell = player.find_spell( id );
+    if ( !spell || !spell->ok() || !visited.insert( id ).second ) continue;
+    for ( const auto& effect : spell->effects() )
+    {
+      // 触发边用于寻找承载替换效果的光环；普通触发子攻击仍由原生构造器创建。
+      if ( effect.trigger_spell_id() ) pending.push_back( effect.trigger_spell_id() );
+      if ( effect.subtype() != A_OVERRIDE_ACTION_SPELL &&
+           effect.subtype() != A_OVERRIDE_ACTION_SPELL_TRIGGERED ) continue;
+      if ( effect.misc_value1() <= 0 || effect.base_value() <= 0 ) continue;
+      const auto replacement = static_cast<unsigned>( effect.base_value() );
+      const auto* target = player.find_spell( replacement );
+      if ( !target || !target->ok() ) continue;
+      result.spells.insert( replacement );
+      pending.push_back( replacement );
+      if ( !original.count( replacement ) ) result.replacement_drivers[replacement].insert( id );
+    }
+  }
+  return result;
+}
