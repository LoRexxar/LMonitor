+bool skill_damage_game_build_at_least( const std::string& actual, const char* minimum )
+{
+  auto parse = []( const std::string& value, std::array<unsigned, 4>& parts )
+  {
+    std::size_t begin = 0;
+    for ( std::size_t index = 0; index < parts.size(); ++index )
+    {
+      const std::size_t end = value.find( '.', begin );
+      if ( index == parts.size() - 1 && end != std::string::npos ) return false;
+      if ( end == begin ) return false;
+      const std::size_t length = end == std::string::npos ? std::string::npos : end - begin;
+      unsigned number = 0;
+      for ( const char character : value.substr( begin, length ) )
+      {
+        if ( character < '0' || character > '9' ) return false;
+        number = number * 10U + static_cast<unsigned>( character - '0' );
+      }
+      parts[index] = number;
+      if ( end == std::string::npos ) return index == parts.size() - 1;
+      begin = end + 1;
+    }
+    return false;
+  };
+
+  std::array<unsigned, 4> actual_parts{};
+  std::array<unsigned, 4> minimum_parts{};
+  if ( !parse( actual, actual_parts ) || !parse( minimum ? minimum : "", minimum_parts ) ) return false;
+  for ( std::size_t index = 0; index < actual_parts.size(); ++index )
+    if ( actual_parts[index] != minimum_parts[index] ) return actual_parts[index] > minimum_parts[index];
+  return true;
+}
