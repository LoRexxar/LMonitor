+std::string skill_damage_talent_effectiveness( const player_t& player )
+{
+  const std::string name = player.name();
+  const bool paired_actor = name.rfind( "skill_damage_reference_", 0 ) == 0 ||
+                            name.rfind( "skill_damage_talent_", 0 ) == 0;
+  const std::string marker = "_trait_";
+  const size_t marker_position = name.rfind( marker );
+  if ( !paired_actor || marker_position == std::string::npos ) return "unknown";
+
+  const std::string entry_text = name.substr( marker_position + marker.size() );
+  if ( entry_text.empty() || !std::all_of( entry_text.begin(), entry_text.end(),
+       []( unsigned char c ) { return std::isdigit( c ); } ) )
+    return "unknown";
+  const unsigned long parsed_entry = std::stoul( entry_text );
+  const unsigned target_entry = static_cast<unsigned>( parsed_entry );
+  if ( target_entry == 0 || target_entry != parsed_entry ) return "unknown";
+
+  for ( const auto& player_trait : player.player_traits )
+    if ( std::get<1>( player_trait ) == target_entry && std::get<2>( player_trait ) > 0 )
+      return "active";
+  return "inactive";
+}
