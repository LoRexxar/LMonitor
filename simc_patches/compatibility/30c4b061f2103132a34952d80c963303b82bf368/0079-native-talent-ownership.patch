+// 英雄节点本身的专精字段可能缺失；选择节点才是原生权威归属。
+std::set<unsigned> skill_damage_trait_specs(const trait_data_t& trait,bool ptr)
+{
+  std::set<unsigned> result;
+  if(trait.tree_index==static_cast<unsigned>(talent_tree::HERO))
+  {
+    for(const auto& selection:trait_data_t::data(trait.id_class,talent_tree::SELECTION,ptr))
+      if(selection.id_sub_tree==trait.id_sub_tree)
+        for(auto spec:selection.id_spec) if(spec) result.insert(spec);
+  }
+  else
+  {
+    for(auto spec:trait.id_spec) if(spec) result.insert(spec);
+    // 专精受限节点也可能由其他专精直接赠送；无专精限制的职业节点仍保持通用。
+    if(!result.empty()) for(auto spec:trait.id_spec_starter) if(spec) result.insert(spec);
+  }
+  return result;
+}
+
+void skill_damage_validate_hero_ownership(player_t* player)
+{
+  if(!player->is_player()) return;
+  for(const auto& selected:player->player_traits)
+    if(const auto* trait=trait_data_t::find(std::get<1>(selected),player->is_ptr()); trait)
+    {
+      const auto specs=skill_damage_trait_specs(*trait,player->is_ptr());
+      if(trait->id_class!=static_cast<unsigned>(util::class_id(player->type)) ||
+         (!specs.empty() && !specs.count(static_cast<unsigned>(player->specialization()))) ||
+         (trait->tree_index==static_cast<unsigned>(talent_tree::HERO) && specs.empty()))
+        throw std::runtime_error("Selected trait belongs to another class or specialization");
+    }
+}
