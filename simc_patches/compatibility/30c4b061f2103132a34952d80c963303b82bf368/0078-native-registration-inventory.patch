+const std::set<unsigned>& skill_damage_actor_racial_spells(const player_t& player)
+{
+  struct entry_t { size_t count=std::numeric_limits<size_t>::max(); std::set<unsigned> spells; };
+  static std::map<const player_t*,entry_t> cache;
+  auto& entry=cache[&player];
+  if(entry.count!=player.skill_damage_native_racial_spell_ids.size())
+  {
+    entry.count=player.skill_damage_native_racial_spell_ids.size();
+    entry.spells=skill_damage_all_racial_spells(*player.dbc);
+    for(auto id:player.skill_damage_native_racial_spell_ids)
+    {
+      const auto closure=skill_damage_trigger_closure(*player.dbc,id);
+      entry.spells.insert(closure.begin(),closure.end());
+    }
+  }
+  return entry.spells;
+}
