+{
+  if (is_pet()) return get_owner_or_self()->get_passive_damage_multiplier(spell, field);
+  const auto field_type = get_type_from_field(field);
+  for (const auto& mod : passive_spell_modifiers_)
+    if (mod.id == static_cast<int>(spell.id()) && mod.field_id == field_type)
