+// 按原生种族目录及触发闭包统一排除，不依赖名称或职业 family。
+const std::set<unsigned>& skill_damage_all_racial_spells(const dbc_t& dbc)
+{
+  static std::map<bool,std::set<unsigned>> cache;
+  const auto found=cache.find(dbc.ptr);
+  if(found!=cache.end()) return found->second;
+  auto& result=cache[dbc.ptr];
+  for(const auto& entry:racial_spell_entry_t::data(dbc.ptr))
+  {
+    const auto ids=skill_damage_trigger_closure(dbc,entry.spell_id);
+    result.insert(ids.begin(),ids.end());
+  }
+  return result;
+}
