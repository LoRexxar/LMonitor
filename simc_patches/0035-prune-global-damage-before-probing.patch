 enum class skill_damage_condition_scope_e { SELF, TARGET };
 
+// 作用域在枚举前确定；不依赖伤害探针、本地化名称或已选技能数量。
+bool skill_damage_global_aura( const spelleffect_data_t& effect, bool target )
+{
+  if ( effect.type() != E_APPLY_AURA || effect.percent() <= 0.0 ) return false;
+  for ( unsigned i = 0; i < NUM_CLASS_FAMILY_FLAGS; ++i )
+    if ( effect.class_flags( i ) ) return false;
+  const bool all_schools = effect.misc_value1() == 127;
+  return target
+    ? ( effect.subtype() == A_MOD_DAMAGE_FROM_CASTER ||
+        ( effect.subtype() == A_MOD_DAMAGE_PERCENT_TAKEN && all_schools ) )
+    : effect.subtype() == A_MOD_DAMAGE_PERCENT_DONE && all_schools;
+}
+
+bool skill_damage_excluded_global_buff( const player_t& player, const buff_t* buff, bool target )
+{
+  if ( !buff || !buff->data().ok() || buff->source != &player ) return false;
+  if ( buff->player != ( target ? player.target : &player ) ) return false;
+  // 激怒的全技能乘区由战士精通实现，不能只查 buff 自身的 aura。
+  if ( player.type == WARRIOR &&
+       ( target ? buff->data().id() == 208086
+                : buff->data().id() == 107574 || buff->data().id() == 184362 ) ) return true;
+  for ( const auto& effect : buff->data().effects() )
+    if ( skill_damage_global_aura( effect, target ) ) return true;
+  return false;
+}
+
+bool skill_damage_pure_global_talent( const spell_data_t* spell )
+{
+  // 只删除纯被动增伤；主动攻击、触发子技能或任何混合效果都保留。
+  if ( !spell || !spell->ok() || !spell->flags( spell_attribute::SX_PASSIVE ) || spell->proc_flags() )
+    return false;
+  bool found = false;
+  for ( const auto& effect : spell->effects() )
+  {
+    if ( effect.type() == E_NONE ) continue;
+    if ( !skill_damage_global_aura( effect, false ) || effect.trigger_spell_id() ) return false;
+    found = true;
+  }
+  return found;
+}
+
+struct skill_damage_excluded_buff_cache_t
+{
+  size_t self_size = 0;
+  size_t target_size = 0;
+  const player_t* target = nullptr;
+  std::vector<buff_t*> buffs;
+};
+std::map<const player_t*, skill_damage_excluded_buff_cache_t> skill_damage_excluded_buff_cache;
+
+const std::vector<buff_t*>& skill_damage_excluded_buffs( player_t& player )
+{
+  auto& cached = skill_damage_excluded_buff_cache[ &player ];
+  const size_t target_size = player.target ? player.target->buff_list.size() : 0;
+  if ( cached.self_size != player.buff_list.size() || cached.target_size != target_size ||
+       cached.target != player.target )
+  {
+    cached.self_size = player.buff_list.size();
+    cached.target_size = target_size;
+    cached.target = player.target;
+    cached.buffs.clear();
+    for ( buff_t* buff : player.buff_list )
+      if ( skill_damage_excluded_global_buff( player, buff, false ) ) cached.buffs.push_back( buff );
+    if ( player.target )
+      for ( buff_t* buff : player.target->buff_list )
+        if ( skill_damage_excluded_global_buff( player, buff, true ) ) cached.buffs.push_back( buff );
+  }
+  return cached.buffs;
+}
+
+void skill_damage_remove_global_talents( player_t* player )
+{
+  if ( !player->is_player() ) return;
+  // 在职业法术/乘区初始化前移除，包括自动赠送的节点。
+  auto& traits = player->player_traits;
+  traits.erase( std::remove_if( traits.begin(), traits.end(), [&]( const auto& selected ) {
+    const auto* trait = trait_data_t::find( std::get<1>( selected ), player->is_ptr() );
+    return trait && skill_damage_pure_global_talent( dbc::find_spell( player, trait->id_spell ) );
+  } ), traits.end() );
+}
