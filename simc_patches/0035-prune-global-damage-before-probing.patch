+// 全 DBC 目录模式不创建 actor、不初始化技能，也不运行伤害探针。
+void export_skill_damage_scope_catalog( sim_t& sim )
+{
+  std::ofstream out( sim.skill_damage_scope_export_file, std::ios::binary | std::ios::trunc );
+  if ( !out ) throw std::runtime_error( "Unable to open skill damage scope catalog" );
+  out << "{\"schema_version\":14,\"simc_revision\":";
+  apl_metadata_json_string( out, sim.skill_damage_revision );
+  out << ",\"game_build\":"; apl_metadata_json_string( out, sim.skill_damage_game_build );
+  out << ",\"talents\":[";
+  bool first = true;
+  for ( const auto& trait : trait_data_t::data( sim.dbc->ptr ) )
+  {
+    const auto* spell = dbc::find_spell( &sim, trait.id_spell );
+    if ( !skill_damage_pure_global_talent( spell ) ) continue;
+    if ( !first ) out << ',';
+    first = false;
+    double multiplier = 1.0;
+    for ( const auto& effect : spell->effects() )
+      if ( skill_damage_global_aura( effect, false ) ) multiplier *= 1.0 + effect.percent();
+    out << "{\"trait_entry_id\":" << trait.id_trait_node_entry
+        << ",\"spell_id\":" << trait.id_spell << ",\"name\":";
+    apl_metadata_json_string( out, trait.name );
+    out << ",\"evidence\":\"dbc_pure_global_damage_talent\",\"dbc_base_multiplier\":";
+    write_skill_damage_json_number( out, multiplier );
+    out << ",\"has_rank_scaling\":"
+        << ( trait.max_ranks > 1 || !trait_definition_effect_entry_t::find(
+             trait.id_trait_definition, sim.dbc->ptr ).empty() ? "true" : "false" ) << '}';
+  }
+  out << "]}\n";
+  out.flush();
+  if ( !out ) throw std::runtime_error( "Unable to write skill damage scope catalog" );
 }
 
