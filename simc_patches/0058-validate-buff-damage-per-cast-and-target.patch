+// 仅比较一次完整施法的期望伤害；中间倍率变化不等于伤害变化。
+double skill_damage_final_amount( const skill_damage_amount_t& amount, int targets )
+{
+  double total = 0.0;
+  const auto add = [&]( const auto& component, bool present ) {
+    if ( !present ) return 0.0;
+    const auto found = component.target_expected.find( targets );
+    const double expected = found != component.target_expected.end() ? found->second
+      : targets == 1 && component.single_target_eligible ? component.expected : 0.0;
+    return expected * component.damage_equivalent_count;
+  };
+  total += add( amount.direct_amount, amount.direct );
+  total += add( amount.tick_amount, amount.periodic );
+  return total;
+}
+
+bool skill_damage_final_changed( double a, double b )
+{
+  return std::abs( a - b ) > std::max( { 1.0, std::abs( a ), std::abs( b ) } ) * 1.0e-8;
+}
