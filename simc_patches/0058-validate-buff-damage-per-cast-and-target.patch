+// 每次只移除一个条件并重新计算；保留只有组合同时存在才生效的条件。
+template <typename Conditions, typename Probe>
+Conditions skill_damage_minimal_conditions( Conditions active, int targets, Probe probe )
+{
+  for ( size_t i = 0; i < active.size(); )
+  {
+    auto reduced = active;
+    reduced.erase( reduced.begin() + i );
+    const auto before = probe( active, targets );
+    const auto after = probe( reduced, targets );
+    if ( std::isfinite( before ) && std::isfinite( after ) && !skill_damage_final_changed( before, after ) )
+    {
+      active = std::move( reduced );
+      i = 0;
+    }
+    else ++i;
+  }
+  return active;
 }

