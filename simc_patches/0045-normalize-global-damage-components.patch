+void player_t::exclude_skill_damage_effect( const spelleffect_data_t& effect )
+{
+  if ( !effect.ok() ) return;
+  if ( !range::contains( skill_damage_excluded_effect_ids_, effect.id() ) )
+    skill_damage_excluded_effect_ids_.push_back( effect.id() );
+  deregister_passive_effect( effect );
+  register_passive_effect_override( effect, 0.0 );
+  if ( effect.type() == E_SCHOOL_DAMAGE )
+    for ( const auto* field : { "sp_coefficient", "ap_coefficient", "coefficient", "delta", "bonus" } )
+      register_passive_effect_override( effect, 0.0, field );
