+// 沿 DBC 的值引用和触发边追踪真正承载增伤的法术，不按父天赋名称建白名单。
+std::map<unsigned, std::set<unsigned>> skill_damage_talent_damage_components( const sim_t& sim, const spell_data_t& spell )
+{
+  static std::map<unsigned, std::map<unsigned, std::set<unsigned>>> cache;
+  auto cached = cache.find( spell.id() );
+  if ( cached != cache.end() ) return cached->second;
+  std::map<unsigned, std::set<unsigned>> result;
+  auto own = skill_damage_declared_damage_indices( *sim.dbc, spell );
+  if ( !own.empty() ) result[spell.id()] = own;
+  const auto& text = sim.dbc->spell_text( spell.id() );
+  const std::string description = text.desc() ? text.desc() : "";
+  static const std::regex external_value( R"(\$([0-9]+)[sw]([0-9]+))", std::regex::icase );
+  for ( std::sregex_iterator it( description.begin(), description.end(), external_value ), end; it != end; ++it )
+  {
+    const unsigned id = std::stoul( (*it)[1].str() );
+    const auto* linked = dbc::find_spell( &sim, id );
+    if ( !linked || !linked->ok() ) continue;
+    auto indices = skill_damage_declared_damage_indices_impl( *sim.dbc, *linked, spell );
+    if ( !indices.empty() ) result[id].insert( indices.begin(), indices.end() );
+  }
+  std::vector<const spell_data_t*> pending{ &spell };
+  std::set<unsigned> visited{ spell.id() };
+  while ( !pending.empty() )
+  {
+    const auto* current = pending.back(); pending.pop_back();
+    for ( const auto& effect : current->effects() )
+    {
+      const auto id = effect.trigger_spell_id();
+      if ( !id || !visited.insert(id).second ) continue;
+      const auto* linked = dbc::find_spell( &sim, id );
+      if ( !linked || !linked->ok() ) continue;
+      auto indices = skill_damage_declared_damage_indices( *sim.dbc, *linked );
+      if ( !indices.empty() ) result[id].insert( indices.begin(), indices.end() );
+      pending.push_back(linked);
+    }
+  }
+  return cache[spell.id()] = result;
+}
