+bool skill_damage_declared_linked_global_buff( const player_t& player, const buff_t* buff )
+{
+  for ( const auto& selected : player.player_traits )
+  {
+    const auto* trait = trait_data_t::find( std::get<1>( selected ), player.is_ptr() );
+    if ( !trait ) continue;
+    const auto* spell = dbc::find_spell( player.sim, trait->id_spell );
+    if ( spell && skill_damage_talent_damage_components( *player.sim, *spell ).count( buff->data().id() ) ) return true;
+  }
+  return false;
 }
 
