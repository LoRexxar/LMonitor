+// 尊重模块已经关闭的状态；同职业的其他专精天赋不能因共享 buff 对象而生效。
+bool skill_damage_available_buff( const player_t& player, const buff_t& buff )
+{
+  static std::map<const buff_t*, bool> availability;
+  const auto found = availability.find( &buff );
+  if ( found != availability.end() ) return found->second;
+  if ( buff.default_chance == 0.0 ) return availability[ &buff ] = false;
+  bool talent_owned = false;
+  for ( const auto& trait : trait_data_t::data( player.is_ptr() ) )
+  {
+    if ( trait.id_class != static_cast<unsigned>( util::class_id( player.type ) ) ) continue;
+    if ( trait.id_spell != buff.data().id() && util::tokenize_fn( trait.name ) != buff.name_str ) continue;
+    talent_owned = true;
+    for ( const auto& selected : player.player_traits )
+      if ( std::get<1>( selected ) == trait.id_trait_node_entry && std::get<2>( selected ) > 0 ) return availability[ &buff ] = true;
+  }
+  return availability[ &buff ] = !talent_owned;
+}
