+// 复用原生护甲公式；动作快照已处理伤害类型、忽略护甲及穿甲。
+// 周期伤害与 player_t::target_mitigation 一致，不进入护甲结算。
+double skill_damage_armor_multiplier( const action_state_t* state, bool periodic )
+{
+  if ( periodic || state->target_armor == 0.0 ) return 1.0;
+  const double armor = state->target_armor;
+  const double coefficient = state->action->player->current.armor_coeff;
+  if ( !std::isfinite( armor ) || armor < 0.0 ||
+       !std::isfinite( coefficient ) || coefficient <= 0.0 )
+    throw std::runtime_error( "护甲结算参数无效" );
+  return 1.0 - util::calculate_armor_resist( armor, coefficient );
 }
