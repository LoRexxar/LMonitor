+bool skill_damage_declared_global_spell( const player_t& player, const spell_data_t& spell, bool target )
+{
+  bool damage = false;
+  for ( const auto& effect : spell.effects() )
+    damage = damage || ( skill_damage_damage_aura( effect, target ) && effect.percent() >= 0.0 );
+  const auto& text = player.dbc->spell_text( spell.id() );
+  const std::string tooltip = text.tooltip() ? text.tooltip() : "";
+  // 基础值为零的光环可以由天赋、精通或层数赋值；作用域不能依赖当前是否点出。
+  // 间接数值只沿“增伤值引用”读取对应效果，不能沿触发技能把准备状态误判成增伤状态。
+  if ( !damage )
+  {
+    static const std::regex reference( R"((?:^|[\r\n\[\]])\s*(?:All |Spell |Ability )?Damage (?:done |dealt )?(?:is )?increased by \$([0-9]+)[sw]([0-9]+))", std::regex::icase );
+    std::smatch match;
+    if ( std::regex_search( tooltip, match, reference ) )
+    {
+      const auto* referenced = dbc::find_spell( &player, std::stoul( match[ 1 ].str() ) );
+      const unsigned index = std::stoul( match[ 2 ].str() );
+      if ( referenced && player.dbc->is_specialization_ability( referenced->id() ) &&
+           !player.dbc->is_specialization_ability( player.specialization(), referenced->id() ) ) return false;
+      damage = referenced && referenced->ok() && index > 0 && index <= referenced->effect_count() &&
+        std::any_of( referenced->effects().begin(), referenced->effects().end(), [&]( const auto& effect ) {
+          return skill_damage_damage_aura( effect, target ) && effect.percent() >= 0.0;
+        } );
+    }
+  }
+  if ( !damage ) return false;
+  if ( !tooltip.empty() ) return skill_damage_text_declares_global_damage( tooltip );
+  // $@spelldesc 是 DBC 官方文本引用；有界闭包覆盖引用和循环，不依赖职业或法术 ID。
+  std::vector<unsigned> pending{ spell.id() };
+  std::set<unsigned> visited;
+  static const std::regex desc_reference( R"(\$@spelldesc([0-9]+))" );
+  while ( !pending.empty() && visited.size() < 64 )
+  {
+    const unsigned id = pending.back(); pending.pop_back();
+    if ( !visited.insert( id ).second ) continue;
+    const auto& referenced = player.dbc->spell_text( id );
+    const std::string desc = referenced.desc() ? referenced.desc() : "";
+    if ( skill_damage_text_declares_global_damage( desc ) ) return true;
+    for ( std::sregex_iterator it( desc.begin(), desc.end(), desc_reference ), end; it != end; ++it )
+      pending.push_back( std::stoul( ( *it )[ 1 ].str() ) );
+  }
+  return false;
+}
