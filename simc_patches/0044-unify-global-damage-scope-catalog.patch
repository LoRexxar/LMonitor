+// 全局作用域依据效果声明和原生公共乘区，不按职业名、技能名或示例 ID 分类。
+bool skill_damage_text_declares_global_damage( std::string text )
+{
+  std::transform( text.begin(), text.end(), text.begin(), []( unsigned char c ) { return std::tolower( c ); } );
+  static const std::regex conditional_statement( R"(\[\s*((all\s+)?(spell\s+|ability\s+)?damage\b))" );
+  text = std::regex_replace( text, conditional_statement, ". $1" );
+  text = std::regex_replace( text, std::regex( R"(\$?\?[^\[\]\r\n]*\[)" ), " " );
+  std::replace( text.begin(), text.end(), '[', ' ' );
+  std::replace( text.begin(), text.end(), ']', ' ' );
+  // 边界必须在主语前，避免把“火焰/技能名 damage increased”截成全技能声明。
+  static const std::regex positive(
+    R"(((^|[.!;\r\n\[\]]|\band\s+)\s*(all\s+)?(spell\s+|ability\s+)?damage(,?\s+(and\s+)?(healing|critical strike chance))*(\s+(done|dealt))?(\s+by\s+you(\s+and\s+your\s+pet)?)?\s+(is\s+)?increased\b)|(\b(your|you\s+and\s+your\s+pet's)\s+damage(\s+dealt)?\s+(is\s+)?increased\b)|(\bincreas(e|es|ed|ing)\s+(all\s+)?(your\s+(spell\s+)?damage|damage\s+(you(\s+both)?\s+deal|dealt\s+by\s+you)|damage\s+and\s+healing\s+by)\b)|(\battacks\s+deal\s+[^%\r\n]{1,48}%\s+additional\s+damage\b)|(\ball\s+(attack\s+and\s+ability\s+)?damage\s+(is\s+)?increased\b)|(\bincreas(e|es|ed|ing)\s+the\s+damage\s+of\s+all\s+your\s+attacks\b)|(\bthe\s+damage\s+of\s+your\s+spells\s+and\s+abilities\s+is\s+increased\b)|((^|[.!;\r\n]|\band\s+)\s*(dealing|taking|suffering|receiving)\s+[^%\r\n]{1,48}%\s+(additional|increased|more)\s+damage\b)|(\bdamage\s+taken\s+from\s+\$@auracaster\s+increased\b)|(\bincreases\s+damage\s+taken\s+from\s+\$@auracaster\s+by\b)|(\btake(s)?\s+[^.;]{0,100}(increased|more)\s+damage\s+from\s+you\b))" );
+  static const std::regex restricted(
+    R"((your\s+damage|damage\s+you\s+deal)\s+(with|from|using|of)\b|damage\s+(dealt\s+)?by\s+your\s+(pet|guardian)|damage\s+from\s+(?!you\b|\$@auracaster(?:[.\s\[\]]|$))|damage\s+from\s+(you|\$@auracaster)['’]|increased\s+damage\s+(with|using|of)\b)" );
+  size_t begin = 0;
+  while ( begin < text.size() )
+  {
+    size_t end = text.find_first_of( ";\n\r", begin );
+    const std::string clause = text.substr( begin, end == std::string::npos ? end : end - begin );
+    if ( std::regex_search( clause, positive ) && !std::regex_search( clause, restricted ) ) return true;
+    if ( end == std::string::npos ) break;
+    begin = end + 1;
+  }
+  return false;
+}
+
+bool skill_damage_damage_aura( const spelleffect_data_t& effect, bool target )
+{
+  if ( effect.type() != E_APPLY_AURA ) return false;
+  if ( target ) return effect.subtype() == A_MOD_DAMAGE_FROM_CASTER ||
+    effect.subtype() == A_MOD_DAMAGE_FROM_CASTER_SPELLS ||
+    effect.subtype() == A_MOD_DAMAGE_FROM_CASTER_SPELLS_LABEL ||
+    effect.subtype() == A_MOD_DAMAGE_PERCENT_TAKEN;
+  return effect.subtype() == A_MOD_DAMAGE_PERCENT_DONE ||
+    ( ( effect.subtype() == A_ADD_PCT_MODIFIER || effect.subtype() == A_ADD_PCT_LABEL_MODIFIER ) &&
+      ( effect.misc_value1() == P_GENERIC || effect.misc_value1() == P_TICK_DAMAGE ) );
+}
