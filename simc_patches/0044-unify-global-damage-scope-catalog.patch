+// 公共乘区检查每个基础伤害学校，完全不枚举技能伤害、层数或目标数。
+bool skill_damage_native_global_buff( const player_t& player, const buff_t* candidate )
+{
+  static std::map<std::pair<const player_t*, const buff_t*>, bool> cache;
+  const auto key = std::make_pair( &player, candidate );
+  auto found = cache.find( key );
+  if ( found != cache.end() ) return found->second;
+  auto* buff = const_cast<buff_t*>( candidate );
+  const int stacks = buff->current_stack;
+  const double value = buff->current_value;
+  struct restore_t {
+    buff_t* buff; int stacks; double value;
+    ~restore_t() { buff->current_stack = stacks; buff->current_value = value; buff->invalidate_cache(); }
+  } restore{ buff, stacks, value };
+  const std::array<school_e, 7> schools{ SCHOOL_PHYSICAL, SCHOOL_HOLY, SCHOOL_FIRE,
+    SCHOOL_NATURE, SCHOOL_FROST, SCHOOL_SHADOW, SCHOOL_ARCANE };
+  double ratio = 0.0;
+  for ( school_e school : schools )
+  {
+    buff->current_stack = 0; buff->current_value = 0.0; buff->invalidate_cache();
+    const double before = player.composite_player_multiplier( school ) *
+      ( player.target ? player.composite_player_target_multiplier( player.target, school ) : 1.0 );
+    buff->current_stack = 1; buff->current_value = buff->default_value; buff->invalidate_cache();
+    const double after = player.composite_player_multiplier( school ) *
+      ( player.target ? player.composite_player_target_multiplier( player.target, school ) : 1.0 );
+    if ( !std::isfinite( before ) || !std::isfinite( after ) || before <= 0.0 || after <= before * ( 1.0 + 1.0e-8 ) )
+      return cache[ key ] = false;
+    const double current = after / before;
+    if ( ratio && std::abs( current - ratio ) > 1.0e-8 * std::max( current, ratio ) ) return cache[ key ] = false;
+    ratio = current;
+  }
+  return cache[ key ] = true;
+}
