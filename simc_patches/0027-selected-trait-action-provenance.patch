+struct skill_damage_selected_trait_effect_t
+{
+  unsigned trait_entry_id = 0;
+  unsigned source_spell_id = 0;
+  unsigned effect_index = 0;
+};
+
+std::vector<skill_damage_selected_trait_effect_t>
+skill_damage_selected_trait_effects( const player_t& player, const action_t& action )
+{
+  std::vector<skill_damage_selected_trait_effect_t> result;
+  if ( !action.data().ok() ) return result;
+  std::set<std::tuple<unsigned, unsigned, unsigned>> seen;
+  for ( const auto* effect : action.sim->dbc->effects_affecting_spell( &action.data() ) )
+  {
+    if ( !effect || !effect->spell_id() ) continue;
+    for ( const auto& player_trait : player.player_traits )
+    {
+      const auto trait_entry_id = std::get<1>( player_trait );
+      if ( !std::get<2>( player_trait ) ) continue;
+      const auto* trait = trait_data_t::find( trait_entry_id, player.is_ptr() );
+      if ( !trait || !trait->id_spell || trait->id_spell != effect->spell_id() ) continue;
+      const auto identity = std::make_tuple( trait_entry_id, trait->id_spell, effect->index() );
+      if ( seen.insert( identity ).second )
+        result.push_back( { trait_entry_id, trait->id_spell, effect->index() } );
+    }
+  }
+  return result;
+}
+
+void write_skill_damage_selected_trait_effects( std::ostream& out, const player_t& player,
+                                                 const action_t& action )
+{
+  const auto effects = skill_damage_selected_trait_effects( player, action );
+  out << '[';
+  for ( size_t i = 0; i < effects.size(); ++i )
+  {
+    if ( i ) out << ',';
+    out << "{\"trait_entry_id\":" << effects[ i ].trait_entry_id;
+    out << ",\"source_spell_id\":" << effects[ i ].source_spell_id;
+    out << ",\"effect_index\":" << effects[ i ].effect_index << '}';
+  }
+  out << ']';
+}
