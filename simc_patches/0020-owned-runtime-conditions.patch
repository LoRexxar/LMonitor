+         positive( layers.versus_multiplier ) && positive( layers.persistent_multiplier ) &&
+         positive( layers.target_multiplier ) && positive( layers.versatility ) &&
+         positive( layers.pet_multiplier ) && positive( layers.target_pet_multiplier );
+}
