+std::vector<std::vector<skill_damage_condition_t>> skill_damage_scenarios( action_t& action )
+{
+  std::map<std::string, std::vector<skill_damage_condition_t>> scenarios;
+  static const std::regex buff_ref( R"(buff\.([A-Za-z0-9_]+))" );
+  if ( action.player->find_action( action.name_str ) == &action )
+    for ( const action_priority_list_t* apl : action.player->action_priority_list )
+      for ( const auto& entry : apl->action_list )
+      {
+      const std::string text = entry.action_;
+      const size_t comma = text.find( ',' );
+      if ( std::string_view( text ).substr( 0, comma ) != action.name_str ) continue;
+      std::vector<skill_damage_condition_t> conditions;
+      for ( auto it = std::sregex_iterator( text.begin(), text.end(), buff_ref ); it != std::sregex_iterator(); ++it )
+      {
+        const std::string token = ( *it )[ 1 ].str();
+        buff_t* buff = skill_damage_owned_player_buff( *action.player, token );
+        if ( buff ) conditions.push_back( { skill_damage_condition_scope_e::SELF, buff, "buff." + token } );
+      }
+      std::sort( conditions.begin(), conditions.end(), []( const auto& left, const auto& right ) {
+        return left.token < right.token;
+      } );
+      conditions.erase( std::unique( conditions.begin(), conditions.end(), []( const auto& left, const auto& right ) {
+        return left.token == right.token;
+      } ), conditions.end() );
+      if ( conditions.empty() ) continue;
+      std::string key;
+      for ( const auto& condition : conditions ) key += condition.token + "\n";
+      scenarios.emplace( std::move( key ), std::move( conditions ) );
+      }
+
+  const auto add_owned_condition = [ &scenarios, &action ](
+      buff_t* buff, skill_damage_condition_scope_e scope ) {
+    if ( !buff || !buff->data().ok() || buff->source != action.player ) return;
+    if ( scope == skill_damage_condition_scope_e::SELF && buff->player != action.player ) return;
+    if ( scope == skill_damage_condition_scope_e::TARGET && buff->player != action.target ) return;
+    const std::string token = ( scope == skill_damage_condition_scope_e::TARGET ? "debuff." : "buff." ) + buff->name_str;
+    scenarios.emplace( token + "\n", std::vector<skill_damage_condition_t>{ { scope, buff, token } } );
+  };
+  for ( buff_t* buff : action.player->buff_list )
+    add_owned_condition( buff, skill_damage_condition_scope_e::SELF );
+  if ( action.target )
+    for ( buff_t* buff : action.target->buff_list )
+      add_owned_condition( buff, skill_damage_condition_scope_e::TARGET );
+
+  std::vector<std::vector<skill_damage_condition_t>> result;
+  result.reserve( scenarios.size() );
+  for ( auto& [ key, conditions ] : scenarios ) result.push_back( std::move( conditions ) );
+  return result;
+}
