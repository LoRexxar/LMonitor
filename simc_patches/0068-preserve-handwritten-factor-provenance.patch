diff --git a/engine/action/damage_multiplier.hpp b/engine/action/damage_multiplier.hpp
--- a/engine/action/damage_multiplier.hpp
+++ b/engine/action/damage_multiplier.hpp
@@ -10,6 +10,8 @@
   double factor;
   unsigned spell_id = 0, effect_index = 0;
   std::string name;
+  std::string file;
+  unsigned line = 0;
 };
 
 struct damage_multiplier_t
@@ -18,8 +20,17 @@
   double value = 1.0;
   std::vector<damage_factor_t> factors;
   damage_multiplier_t() = default;
-  damage_multiplier_t(double v) : value(v)
-  { if (enabled && v != 1.0) factors.push_back({v, 0, 0, ""}); }
+  damage_multiplier_t(double v, const char* file = __builtin_FILE(), unsigned line = __builtin_LINE()) : value(v)
+  {
+    if (enabled && v != 1.0)
+    {
+      std::string path(file);
+      for (auto& c : path) if (c == 92) c = '/';
+      const auto start = path.find("engine/");
+      if (start != std::string::npos) path.erase(0, start);
+      factors.push_back({v, 0, 0, "", path, line});
+    }
+  }
   operator double() const { return value; }
   damage_multiplier_t& operator*=(const damage_multiplier_t& rhs)
   {
@@ -59,3 +70,30 @@
 
 template<class T, std::enable_if_t<std::is_same_v<T, damage_multiplier_t>, int> = 0>
 inline double format_as(const T& value) { return value.value; }
+
+// 已有来源不覆盖；补齐在数值操作数进入乘法时的真实调用位置。
+inline damage_multiplier_t native_damage_factor(damage_multiplier_t value,
+  const char* file = __builtin_FILE(), unsigned line = __builtin_LINE())
+{
+  if (damage_multiplier_t::enabled)
+    for (auto& factor : value.factors)
+      if (!factor.spell_id && (factor.file.empty() || factor.file.find("damage_multiplier.hpp") != std::string::npos))
+      {
+        auto origin = damage_multiplier_t(factor.factor, file, line);
+        if (!origin.factors.empty()) { factor.file = origin.factors[0].file; factor.line = line; }
+      }
+  return value;
+}
+
+template<class Effect>
+inline auto damage_source_effect(const Effect& effect, int) -> decltype((effect._eff)) { return effect._eff; }
+template<class Effect>
+inline const Effect& damage_source_effect(const Effect& effect, long) { return effect; }
+
+template<class Effect>
+inline damage_multiplier_t damage_effect_factor(double value, const Effect& effect)
+{
+  if (!damage_multiplier_t::enabled) return damage_multiplier_t(value);
+  const auto& source = damage_source_effect(effect, 0);
+  return damage_factor(value, source.spell()->id(), source.index()+1, source.spell()->name_cstr());
+}
