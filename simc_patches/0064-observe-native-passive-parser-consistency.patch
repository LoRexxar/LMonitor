+// DBC candidates and even consistent parser/base/runtime values do not prove
+// retained source attribution: derived actions can overwrite a base with the
+// same number. Export this only as diagnostics; it MUST NOT authorize division.
+void skill_damage_observe_passive_consistency( const action_state_t* state, bool periodic,
+    std::vector<skill_damage_runtime_layers_t::specialization_passive_effect_t>& effects )
+{
+  auto& action = *state->action;
+  auto* player = action.player;
+  if ( effects.empty() || !player || player->is_pet() ) return;
+  const auto field = periodic ? "periodic_damage" : "direct_damage";
+  const auto spell = player->reporting_parse_action.find( action.data().id() );
+  if ( spell == player->reporting_parse_action.end() ) return;
+  const auto parsed = spell->second.find( field );
+  if ( parsed == spell->second.end() ) return;
+  const double parser_multiplier = player->get_passive_value( action.data(), field )[ 2 ];
+  double& base = periodic ? action.base_td_multiplier : action.base_dd_multiplier;
+  const auto same = []( double a, double b ) {
+    return std::isfinite( a ) && std::isfinite( b ) && a > 0 && b > 0 &&
+           std::abs( a - b ) <= std::max( a, b ) * 1e-9;
+  };
+  if ( !same( base, parser_multiplier ) ) return;
+  double product = 1.0;
+  std::map<std::pair<unsigned, unsigned>, double> applied;
+  for ( const auto* effect : parsed->second )
+  {
+    if ( !effect ) return;
+    // Flat modifiers do not enter the percentage product. Unknown reporting
+    // fields must not be silently mistaken for percent damage modifiers.
+    if ( effect->subtype() == A_ADD_FLAT_MODIFIER || effect->subtype() == A_ADD_FLAT_LABEL_MODIFIER ) continue;
+    if ( effect->subtype() != A_ADD_PCT_MODIFIER && effect->subtype() != A_ADD_PCT_LABEL_MODIFIER ) return;
+    const auto factor = 1.0 + effect->average( player ) * 0.01;
+    if ( !std::isfinite( factor ) || factor <= 0 ||
+         !applied.emplace( std::make_pair( effect->spell_id(), effect->index() ), factor ).second ) return;
+    product *= factor;
+  }
+  // Overrides, missing reporting, removals and effect masks cannot be inferred
+  // from source registration: require the retained exact effect product.
+  if ( !same( product, parser_multiplier ) ) return;
+  const double original_base = base;
+  struct restore_t { double& value; double original; ~restore_t() { value = original; } } restore{ base, base };
+  const auto probe = [&]() {
+    skill_damage_reset_probe_rng( action );
+    return periodic ? action.composite_ta_multiplier( state ) : action.composite_da_multiplier( state );
+  };
+  const double runtime = probe();
+  base = 1.0;
+  const double without_parser = probe();
+  base = original_base;
+  skill_damage_reset_probe_rng( action );
+  const double snapshot = periodic ? state->ta_multiplier : state->da_multiplier;
+  if ( !same( snapshot, runtime ) || !same( runtime, without_parser * parser_multiplier ) ) return;
+  for ( auto& candidate : effects )
+  {
+    const auto found = applied.find( { candidate.source_spell_id, candidate.effect_index } );
+    if ( found == applied.end() ) continue;
+    candidate.factor = found->second;
+    candidate.application_action_spell_id = action.data().id();
+    candidate.parser_multiplier = parser_multiplier;
+    candidate.base_multiplier = original_base;
+    candidate.runtime_multiplier = runtime;
+    candidate.runtime_without_parser_multiplier = without_parser;
+  }
 }
 
