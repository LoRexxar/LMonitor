+unsigned apl_metadata_action_spell_id( const action_t& action )
+{
+  if ( action.data().ok() && action.data().id() ) return action.data().id();
+  if ( action.data_reporting().ok() && action.data_reporting().id() )
+    return action.data_reporting().id();
+  if ( action.id > 1 )
+  {
+    const spell_data_t* spell = action.player->find_spell( action.id );
+    if ( spell && spell->ok() ) return action.id;
+  }
+  return 0;
+}
+
+const action_t* apl_metadata_find_action( const player_t& player, const std::string& token )
+{
+  if ( const action_t* action = player.find_action( token ) ) return action;
+  for ( const action_t* action : player.action_list )
+    if ( action && util::str_compare_ci( action->name_str, token ) ) return action;
+  return nullptr;
+}
