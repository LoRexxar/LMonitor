+unsigned apl_metadata_action_spell_id( const action_t& action )
+{
+  if ( action.data().ok() && action.data().id() ) return action.data().id();
+  if ( action.data_reporting().ok() && action.data_reporting().id() )
+    return action.data_reporting().id();
+  if ( action.id > 1 )
+  {
+    const spell_data_t* spell = action.player->find_spell( action.id );
+    if ( spell && spell->ok() ) return action.id;
+  }
+  return 0;
+}
