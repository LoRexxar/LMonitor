+std::vector<skill_damage_runtime_layers_t::specialization_passive_effect_t>
+skill_damage_specialization_passive_effects( const action_t& action, bool periodic )
+{
+  std::vector<skill_damage_runtime_layers_t::specialization_passive_effect_t> result;
+  if ( !action.player || !action.data().ok() )
+    return result;
+
+  const auto class_id = static_cast<unsigned>( util::class_id( action.player->type ) );
+  const auto spec_id = static_cast<unsigned>( action.player->specialization() );
+  std::unordered_set<unsigned> specialization_spell_ids;
+  for ( const auto& entry : specialization_spell_entry_t::data( action.player->is_ptr() ) )
+    if ( entry.class_id == class_id && entry.specialization_id == spec_id )
+      specialization_spell_ids.insert( entry.spell_id );
+
+  const auto property = periodic ? P_TICK_DAMAGE : P_GENERIC;
+  for ( const auto* effect : action.sim->dbc->effects_affecting_spell( &action.data() ) )
+  {
+    if ( !effect || effect->type() != E_APPLY_AURA || effect->subtype() != A_ADD_PCT_MODIFIER ||
+         effect->misc_value1() != property ||
+         specialization_spell_ids.find( effect->spell_id() ) == specialization_spell_ids.end() )
+      continue;
+    const auto* source = effect->spell();
+    if ( !source || !source->ok() || !source->flags( spell_attribute::SX_PASSIVE ) )
+      continue;
+    const double factor = 1.0 + effect->percent();
+    if ( !std::isfinite( factor ) || factor <= 0.0 || std::abs( factor - 1.0 ) <= 1.0e-12 )
+      continue;
+    result.push_back( {
+      source->id(), effect->index(), source->name_cstr(), factor
+    } );
+  }
+  return result;
+}
