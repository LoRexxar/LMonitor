diff --git a/engine/action/damage_multiplier.hpp b/engine/action/damage_multiplier.hpp
new file mode 100644
--- /dev/null
+++ b/engine/action/damage_multiplier.hpp
@@ -0,0 +1,61 @@
+// 伤害乘数随实际运算传播；赋值覆盖会同时丢弃旧来源，禁止按最终数值反推。
+#pragma once
+#include <vector>
+#include <string>
+#include <utility>
+#include <type_traits>
+
+struct damage_factor_t
+{
+  double factor;
+  unsigned spell_id = 0, effect_index = 0;
+  std::string name;
+};
+
+struct damage_multiplier_t
+{
+  inline static thread_local bool enabled = false;
+  double value = 1.0;
+  std::vector<damage_factor_t> factors;
+  damage_multiplier_t() = default;
+  damage_multiplier_t(double v) : value(v)
+  { if (enabled && v != 1.0) factors.push_back({v, 0, 0, ""}); }
+  operator double() const { return value; }
+  damage_multiplier_t& operator*=(const damage_multiplier_t& rhs)
+  {
+    if (this == &rhs) { auto copy = rhs; return *this *= copy; }
+    value *= rhs.value;
+    factors.insert(factors.end(), rhs.factors.begin(), rhs.factors.end());
+    return *this;
+  }
+  damage_multiplier_t& operator/=(const damage_multiplier_t& rhs)
+  {
+    if (this == &rhs) { auto copy = rhs; return *this /= copy; }
+    value /= rhs.value;
+    for (auto factor : rhs.factors) { factor.factor = 1.0 / factor.factor; factors.push_back(factor); }
+    return *this;
+  }
+  // 加法不是独立乘区，保留数值但不伪造可乘的来源。
+  damage_multiplier_t& operator+=(double rhs) { *this = damage_multiplier_t(value + rhs); return *this; }
+  damage_multiplier_t& operator-=(double rhs) { *this = damage_multiplier_t(value - rhs); return *this; }
+  friend damage_multiplier_t operator*(damage_multiplier_t a, const damage_multiplier_t& b) { return a *= b; }
+  template<class T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+  friend damage_multiplier_t operator*(damage_multiplier_t a, T b) { return a *= damage_multiplier_t(b); }
+  template<class T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+  friend damage_multiplier_t operator*(T a, damage_multiplier_t b) { return damage_multiplier_t(a) *= b; }
+  friend damage_multiplier_t operator/(damage_multiplier_t a, const damage_multiplier_t& b) { return a /= b; }
+  template<class T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+  friend damage_multiplier_t operator/(damage_multiplier_t a, T b) { return a /= damage_multiplier_t(b); }
+  template<class T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+  friend damage_multiplier_t operator/(T a, damage_multiplier_t b) { return damage_multiplier_t(a) /= b; }
+};
+
+inline damage_multiplier_t damage_factor(double value, unsigned spell, unsigned index, const char* name)
+{
+  damage_multiplier_t result(value);
+  if (!result.factors.empty()) result.factors[0] = {value, spell, index, name};
+  return result;
+}
+
+template<class T, std::enable_if_t<std::is_same_v<T, damage_multiplier_t>, int> = 0>
+inline double format_as(const T& value) { return value.value; }
