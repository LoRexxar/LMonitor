--- /dev/null
+++ b/engine/player/skill_damage_passive_probe.hpp
@@ -0,0 +1,45 @@
+#pragma once
+#include <cstdlib>
+#include <limits>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <utility>
+
+// Diagnostic exporter process only. Do not mutate DBC or reuse the global
+// damage-normalization exclusion hook: those interventions are not equivalent.
+inline const std::set<std::pair<unsigned, unsigned>>& skill_damage_parser_probe_exclusions()
+{
+  static const auto exclusions = [] {
+    std::set<std::pair<unsigned, unsigned>> values;
+    const char* env = std::getenv( "LMONITOR_SIMC_PARSER_EXCLUDE" );
+    if ( !env || !*env ) return values;
+    std::string input( env );
+    size_t begin = 0;
+    while ( begin < input.size() )
+    {
+      const auto end = input.find( ',', begin );
+      const auto token = input.substr( begin, end == std::string::npos ? end : end - begin );
+      const auto colon = token.find( ':' );
+      const auto number = []( const std::string& text ) -> unsigned {
+        if ( text.empty() || text.find_first_not_of( "0123456789" ) != std::string::npos )
+          throw std::runtime_error( "Invalid parser-only exclusion identity" );
+        const auto value = std::stoul( text );
+        if ( value > std::numeric_limits<unsigned>::max() )
+          throw std::runtime_error( "Parser-only exclusion identity overflow" );
+        return static_cast<unsigned>( value );
+      };
+      if ( colon == std::string::npos || token.find( ':', colon + 1 ) != std::string::npos )
+        throw std::runtime_error( "Expected source_spell_id:zero_based_effect_index" );
+      const auto spell = number( token.substr( 0, colon ) );
+      const auto index = number( token.substr( colon + 1 ) );
+      if ( !spell || !values.emplace( spell, index ).second )
+        throw std::runtime_error( "Invalid or duplicate parser-only exclusion" );
+      if ( end == std::string::npos ) break;
+      begin = end + 1;
+      if ( begin == input.size() ) throw std::runtime_error( "Empty parser-only exclusion" );
+    }
+    return values;
+  }();
+  return exclusions;
+}
