+void skill_damage_normalize_crit( player_t& player )
+{
+  // 基础暴击固定 20%，保留职业/天赋的暴击修正；装备暴击等级不进入归一化。
+  const double base_crit = player.dbc->all_crit_base( player.type, player.level() );
+  player.current.stats.crit_rating = 0.0;
+  const double old_all_crit = player.get_passive_player_value( base_crit, "all_crit" );
+  const double new_all_crit = player.get_passive_player_value( 0.20, "all_crit" );
+  player.current.attack_crit_chance += new_all_crit - old_all_crit;
+  player.current.spell_crit_chance +=
+      player.get_passive_player_value( new_all_crit, "spell_crit" ) -
+      player.get_passive_player_value( old_all_crit, "spell_crit" );
+  player.invalidate_cache( CACHE_ATTACK_CRIT_CHANCE );
+  player.invalidate_cache( CACHE_SPELL_CRIT_CHANCE );
+}
