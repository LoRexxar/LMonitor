+skill_damage_runtime_layers_t skill_damage_runtime_layers( const action_state_t* state, bool periodic )
+{
+  skill_damage_runtime_layers_t layers;
+  layers.action_multiplier = periodic ? state->ta_multiplier : state->da_multiplier;
+  layers.player_multiplier = state->player_multiplier;
+  // Keep the legacy schema key neutral: this SimC action_state has no
+  // independent versus multiplier in composite_da/ta_multiplier().
+  layers.versus_multiplier = 1.0;
+  layers.persistent_multiplier = state->persistent_multiplier;
+  layers.target_multiplier = periodic ? state->target_ta_multiplier : state->target_da_multiplier;
+  layers.versatility = state->versatility;
+  layers.pet_multiplier = state->pet_multiplier;
+  layers.target_pet_multiplier = state->target_pet_multiplier;
+  return layers;
+}
