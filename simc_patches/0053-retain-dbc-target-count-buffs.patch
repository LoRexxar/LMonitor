+// 目标数修饰不一定声明伤害倍率；DBC 技能选择器限定了它的局部范围。
+bool skill_damage_local_target_buff( const buff_t& buff, const action_t* action = nullptr )
+{
+  for (const auto& effect : buff.data().effects())
+    if (skill_damage_global_aura(effect, false)) return false;
+  for (const auto& effect : buff.data().effects())
+  {
+    if (effect.type() != E_APPLY_AURA || effect.subtype() != A_ADD_FLAT_MODIFIER ||
+        (effect.misc_value1() != P_CHAIN_TARGETS && effect.misc_value1() != P_MAX_TARGETS) ||
+        effect.base_value() <= 0.0) continue;
+    bool selected_skills = false;
+    for (unsigned i = 0; i < NUM_CLASS_FAMILY_FLAGS; ++i) selected_skills |= effect.class_flags(i) != 0;
+    if (selected_skills && (!action || action->data().affected_by(effect))) return true;
+  }
+  return false;
+}
