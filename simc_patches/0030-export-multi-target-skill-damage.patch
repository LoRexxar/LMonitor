+double skill_damage_target_hit( action_t& action, player_t* target, unsigned n_targets,
+                                unsigned chain_target, bool periodic )
+{
+  const auto amount_type = periodic ? result_amount_type::DMG_OVER_TIME : result_amount_type::DMG_DIRECT;
+  action_state_t* hit_state = action.get_state();
+  if ( !hit_state )
+    throw std::runtime_error( "target scenario state allocation failed" );
+  hit_state->target = target;
+  hit_state->n_targets = n_targets;
+  hit_state->chain_target = chain_target;
+  hit_state->result = RESULT_HIT;
+  action.snapshot_state( hit_state, amount_type );
+  hit_state->attack_power = 100.0;
+  hit_state->spell_power = 100.0;
+  const double hit = periodic ? action.calculate_tick_amount( hit_state, 1.0 )
+                              : action.calculate_direct_amount( hit_state );
+  action_state_t::release( hit_state );
+  return hit;
+}
+
+void skill_damage_populate_target_scenarios( action_t& action, skill_damage_amount_t& amount )
+{
+  static constexpr std::array<int, 5> scenario_counts = { 1, 2, 5, 10, 20 };
+  if ( !action.target )
+    throw std::runtime_error( "target scenario action target unavailable" );
+
+  const int saved_desired_targets = action.sim->desired_targets;
+  try
+  {
+    for ( int scenario_count : scenario_counts )
+    {
+      // Keep the full target count visible to class/action formulas while using
+      // action_state_t's native n_targets/chain_target AoE calculation path.
+      action.sim->desired_targets = scenario_count;
+      const int configured_targets = action.n_targets();
+      const int hit_targets = configured_targets < 0
+                            ? scenario_count
+                            : configured_targets > 0
+                                ? std::min( scenario_count, configured_targets )
+                                : 1;
+      double direct_hit = 0.0;
+      double tick_hit = 0.0;
+      for ( int index = 0; index < hit_targets; ++index )
+      {
+        if ( amount.direct )
+          direct_hit += skill_damage_target_hit(
+              action, action.target, as<unsigned>( hit_targets ), as<unsigned>( index ), false );
+        if ( amount.periodic )
+          tick_hit += skill_damage_target_hit(
+              action, action.target, as<unsigned>( hit_targets ), as<unsigned>( index ), true );
+      }
+      if ( amount.direct )
+        amount.direct_amount.target_hit[ scenario_count ] = direct_hit;
+      if ( amount.periodic )
+        amount.tick_amount.target_hit[ scenario_count ] = tick_hit;
+    }
+  }
+  catch ( ... )
+  {
+    action.sim->desired_targets = saved_desired_targets;
+    throw;
+  }
+  action.sim->desired_targets = saved_desired_targets;
+}
